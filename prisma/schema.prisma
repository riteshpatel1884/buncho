generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/* ---------- Enums ---------- */

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum PostKind {
  BLOG
  CODING
}

enum ProblemType {
  CONCEPTUAL
  PRACTICAL
  DEBUGGING
  SYSTEM_DESIGN
  CASE_STUDY
}

enum ProgressStatus {
  ATTEMPTED
  COMPLETED
}

// Phase 3
enum AnswerStatus {
  PUBLISHED
  UNSHARED
  HIDDEN
}

enum ReportReason {
  INCORRECT
  COPIED
  INAPPROPRIATE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

// Phase 7
enum MockStatus {
  IN_PROGRESS
  COMPLETED
}

// Phase 8: subscriptions
enum PaymentStatus {
  PENDING // shown as "Not paid" in the admin
  PAID
  FAILED
}

// Which gateway took (or was asked to take) a Pro payment: Cashfree for INR, Dodo Payments for other currencies
enum PaymentProvider {
  CASHFREE
  DODO
}

// Phase 8: offers and promo codes (set by the admin at /admin/billing)
enum OfferType {
  PERCENT_OFF
  FLAT_OFF
  EXTRA_DAYS
}

// User reports sent from the /report page and shown in /admin/reports
enum SupportKind {
  PROBLEM
  PRO_PLAN
  OTHER
}

enum SupportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Blog
enum PostStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  SCHEDULED
}

enum PostLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Sponsor banners on /problems: the two columns of the "Sponsored" section
enum AdSlot {
  SLOT_1
  SLOT_2
}

enum AdStatus {
  PENDING_PAYMENT // checkout started, not paid yet
  PAID // paid, waiting for the admin to approve
  APPROVED // approved by the admin. Shown while startsAt <= now < endsAt
  REJECTED // admin said no (refund by hand in the Dodo dashboard)
  ENDED // admin ended it early
  FAILED // the checkout could not be created
}

/* ---------- Core models (Phase 1-2) ---------- */

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions      Submission[]
  bookmarks        Bookmark[]
  progress         ProblemProgress[]
  // Phase 3
  communityAnswers CommunityAnswer[]
  answerVotes      AnswerVote[]
  answerBookmarks  AnswerBookmark[]
  reports          Report[]
  comments         AnswerComment[]
  // Phase 4
  evaluations      Evaluation[]
  // Phase 7
  jobTargets       JobTarget[]
  mockAssessments  MockAssessment[]
  // Phase 8: plans and billing
  // Lifetime count of mock attempts started. Kept on the user (not derived from MockAssessment rows) so that
  // deleting a role, which cascades to its mocks, cannot reset the free attempt.
  mockAttemptsUsed Int              @default(0)
  subscription     Subscription?
  payments         Payment[]
  // User reports (/report)
  supportReports   SupportReport[]
  // Blog
  blogPosts        BlogPost[]
  blogLikes        BlogLike[]
  blogComments     BlogComment[]
  blogFeedback     BlogFeedback[]
  // Sponsor banners
  adBookings       AdBooking[]

  @@index([email])
}

model Topic {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  order       Int       @default(0)
  problems    Problem[]
}

model Problem {
  id                String      @id @default(cuid())
  slug              String      @unique
  title             String
  description       String      @db.Text // Markdown
  topicId           String
  topic             Topic       @relation(fields: [topicId], references: [id])
  subcategory       String?
  difficulty        Difficulty
  type              ProblemType
  roles             String[]
  estimatedMinutes  Int         @default(10)
  hints             String[]
  // If true, users may reveal the solution without submitting an attempt
  allowDirectReveal Boolean     @default(false)
  // Pro-only question: free users see the title and a short preview, but not the full question, hints, answer editor,
  // AI feedback, reference answer or community answers. Enforced on the server (see lib/pro-access.js).
  proOnly           Boolean     @default(false)
  published         Boolean     @default(true)
  position          Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Phase 8: interview insights (Pro). Only ever selected for users with an active subscription.
  // askedFrequency: whole percent (0-100) of reported interviews where this question came up. Null = no data yet.
  askedFrequency   Int?
  askedByCompanies String[]

  // Phase 5: production challenges
  isChallenge  Boolean @default(false)
  scenarioData Json? // [{ title, kind, content }] logs, configs, sample data
  steps        Json? // [{ title, prompt }] step-by-step answer
  rubric       Json? // [{ id, criterion, weight }] used by the AI, shown after feedback

  expertSolution   ExpertSolution?
  related          Problem[]         @relation("RelatedProblems")
  relatedBy        Problem[]         @relation("RelatedProblems")
  submissions      Submission[]
  bookmarks        Bookmark[]
  progress         ProblemProgress[]
  // Phase 3
  communityAnswers CommunityAnswer[]
  // Phase 4
  evaluations      Evaluation[]
  // Phase 7
  jobPlanItems     JobPlanItem[]
  // User reports (/report)
  supportReports   SupportReport[]

  @@index([topicId, difficulty])
  @@index([published, difficulty])
  @@index([isChallenge, published])
  @@index([proOnly, published])
}

// Authoritative, admin-curated. Kept separate from user content on purpose.
model ExpertSolution {
  id           String    @id @default(cuid())
  problemId    String    @unique
  problem      Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  content      String    @db.Text // Markdown
  // Phase 5: alternative approaches and trade-offs (Markdown)
  alternatives String?   @db.Text
  // Only set these after a real human review
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Private to the user. Public sharing creates a separate CommunityAnswer copy.
model Submission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 4
  evaluations Evaluation[]

  @@unique([userId, problemId])
  @@index([problemId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, problemId])
  @@index([userId])
}

model ProblemProgress {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId        String
  problem          Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status           ProgressStatus @default(ATTEMPTED)
  solutionRevealed Boolean        @default(false)
  completedAt      DateTime?
  lastActivityAt   DateTime       @default(now())
  createdAt        DateTime       @default(now())

  @@unique([userId, problemId])
  @@index([userId, status])
}

/* ---------- Community (Phase 3) ---------- */

// Public copy of a user's answer, created only when they choose to share.
// Editing the private Submission never changes this until the user updates the shared version.
model CommunityAnswer {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  content   String       @db.Text // Markdown
  anonymous Boolean      @default(false)
  status    AnswerStatus @default(PUBLISHED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  votes     AnswerVote[]
  bookmarks AnswerBookmark[]
  reports   Report[]
  comments  AnswerComment[]

  // One shared answer per user per problem
  @@unique([userId, problemId])
  @@index([problemId, status])
}

// "Helpful" votes. The unique constraint prevents duplicate votes.
model AnswerVote {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerId  String
  answer    CommunityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, answerId])
  @@index([answerId])
}

model AnswerBookmark {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerId  String
  answer    CommunityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, answerId])
  @@index([userId])
}

// One report per user per answer. Open reports from distinct users drive auto-hide.
model Report {
  id         String          @id @default(cuid())
  reporterId String
  reporter   User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  answerId   String
  answer     CommunityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?         @db.Text
  status     ReportStatus    @default(OPEN)
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  @@unique([reporterId, answerId])
  @@index([status, createdAt])
  @@index([answerId])
}

model AnswerComment {
  id        String          @id @default(cuid())
  answerId  String
  answer    CommunityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String          @db.Text
  createdAt DateTime        @default(now())

  @@index([answerId, createdAt])
  @@index([userId, createdAt])
}

/* ---------- AI feedback (Phase 4) ---------- */

// One row per evaluation run; the newest row for a submission is shown.
model Evaluation {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId    String
  problem      Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contentHash  String // sha256 of the answer that was evaluated
  score        Int // 0-100, summed from the rubric
  scores       Json // { coverage, accuracy, reasoning, clarity }
  feedback     Json // { summary, strengths, missing, inaccuracies, rubricResults, ... }
  provider     String
  model        String
  latencyMs    Int
  fallbacks    Int        @default(0) // providers that failed before this one answered
  createdAt    DateTime   @default(now())

  @@index([submissionId, createdAt])
  @@index([userId, createdAt])
}

/* ---------- Job description preparation (Phase 7) ---------- */

// A role the user is preparing for. The JD text is private to the user.
model JobTarget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  company   String?
  jdText    String   @db.Text
  skills    Json // [{ key, label, importance, weight, mentions, evidence[] }]
  coverage  Json // { [skillKey]: number of matching questions in the bank when the plan was built }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planItems JobPlanItem[]
  mocks     MockAssessment[]

  @@index([userId, createdAt])
}

// One question in a role's practice plan. Progress is read from ProblemProgress and Evaluation, not stored here.
model JobPlanItem {
  id        String    @id @default(cuid())
  jobId     String
  job       JobTarget @relation(fields: [jobId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  skillKeys String[]
  priority  Int
  reason    String

  @@unique([jobId, problemId])
  @@index([jobId, priority])
}

model MockAssessment {
  id              String     @id @default(cuid())
  jobId           String
  job             JobTarget  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemIds      String[]
  durationMinutes Int
  status          MockStatus @default(IN_PROGRESS)
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  score           Int?
  results         Json? // { questions: [{ problemId, title, skillKeys, score|null, state }], partial }

  @@index([jobId, startedAt])
  @@index([userId, status])
}

/* ---------- Plans and billing (Phase 8) ---------- */

// One row per user. Pro is active while currentPeriodEnd is in the future, so nothing has to run on a schedule
// to expire it. Each successful payment pushes currentPeriodEnd forward.
model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             String   @default("PRO_MONTHLY")
  startedAt        DateTime @default(now())
  currentPeriodEnd DateTime
  updatedAt        DateTime @updatedAt
}

// One row (id "default") with the editable Pro pricing, changed by the admin at /admin/billing.
// If it is missing, the defaults in lib/pricing.js are used.
model BillingSettings {
  id            String    @id @default("default")
  proName       String    @default("Buncho Pro")
  priceInr      Int       @default(99)
  // Price when paying in another currency (Dodo Payments), in US cents. 299 = $2.99
  priceUsdCents Int       @default(299)
  periodMonths  Int       @default(1)
  // Untick in the admin page to pause all new payments
  checkoutOpen  Boolean   @default(true)
  // Site-wide offer, applied to everyone automatically until offerEndsAt (if set)
  offerOn       Boolean   @default(false)
  offerLabel    String?
  offerType     OfferType @default(PERCENT_OFF)
  offerValue    Int       @default(0)
  offerEndsAt   DateTime?
  updatedAt     DateTime  @updatedAt
}

// Promo codes typed in at checkout. A valid code replaces the site-wide offer (they do not stack).
model DiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique // always upper case
  type           OfferType
  value          Int // percent, rupees or days depending on type
  active         Boolean   @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  maxRedemptions Int? // null = unlimited
  perUserLimit   Int       @default(1)
  redeemedCount  Int       @default(0)
  note           String?
  createdAt      DateTime  @default(now())
}

// One row per Pro payment attempt. orderId is our own id ("bnc_..."), sent to the gateway as order_id.
// provider is CASHFREE for INR and DODO for other currencies. status: PENDING is shown as "Not paid" in the admin.
// Price, period and bonus are stored on the row, so changing settings later never alters a payment already made.
model Payment {
  id            String          @id @default(cuid())
  orderId       String          @unique
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  plan          String
  provider      PaymentProvider @default(CASHFREE)
  // Minor units: paise when currency is INR, cents when it is USD (the column name is kept from the INR-only days)
  amountPaise   Int
  currency      String          @default("INR")
  status        PaymentStatus   @default(PENDING)
  cfPaymentId   String? // Cashfree
  dodoSessionId String? // Dodo checkout session
  dodoPaymentId String? // Dodo payment
  paymentMethod String? // UPI, CARD, ... as reported by the gateway
  payerEmail    String?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  periodMonths  Int             @default(1)
  bonusDays     Int             @default(0)
  listPaise     Int             @default(0) // price before any discount (0 on orders made before this column existed)
  discountPaise Int             @default(0)
  discountCode  String?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/* ---------- Sponsor banners (the "Sponsored" section on /problems) ---------- */

// One row per banner purchase, paid through Dodo Payments. The flow is PENDING_PAYMENT -> PAID -> APPROVED.
// A banner is live while status is APPROVED and now is between startsAt and endsAt, so expiry needs no cron job.
// Price, currency and period are stored on the row, so changing the env prices later never alters a booking.
model AdBooking {
  id            String   @id @default(cuid())
  orderId       String   @unique // our own id ("ad_..."), sent to Dodo as metadata.order_id
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  slot          AdSlot
  status        AdStatus @default(PENDING_PAYMENT)

  // What the advertiser wants shown
  companyName   String
  tagline       String
  description   String?  @db.Text
  linkUrl       String
  logoUrl       String?
  ctaLabel      String   @default("Learn more")
  contactEmail  String

  // Payment (Dodo)
  amountCents   Int
  currency      String   @default("USD")
  periodMonths  Int      @default(1)
  dodoSessionId String?
  dodoPaymentId String?
  paymentMethod String?
  payerEmail    String?
  paidAt        DateTime?

  // Review and schedule (set by the admin)
  reviewedAt    DateTime?
  startsAt      DateTime?
  endsAt        DateTime?
  adminNote     String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, slot, endsAt])
  @@index([userId, createdAt])
}

/* ---------- User reports (the /report page, shown in /admin/reports) ---------- */

// A problem a user reports: a mistake in a question or its solution, a Pro plan or payment issue, or anything else.
// Not to be confused with Report above, which is a user flagging someone else's community answer.
model SupportReport {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          SupportKind
  issue         String // key from ISSUES in lib/support.js
  problemId     String?
  problem       Problem?      @relation(fields: [problemId], references: [id], onDelete: SetNull)
  details       String        @db.Text
  transactionId String? // payment / UPI / bank reference, for Pro plan reports
  contactEmail  String?
  status        SupportStatus @default(OPEN)
  adminNote     String?       @db.Text // reply shown to the user on /report
  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([problemId])
}

/* ---------- Blog ---------- */

// A post is public when status is PUBLISHED or SCHEDULED and publishedAt is in the past. Scheduling therefore needs
// no cron job: a SCHEDULED post simply starts matching the public query once its time has passed.
model BlogPost {
  id            String     @id @default(cuid())
  slug          String     @unique
  // Old slugs keep working: the article route redirects them (301) to the current slug
  previousSlugs String[]
  kind PostKind @default(BLOG)
  folder    String   @default("")
  sortOrder Int      @default(0)
  title         String
  excerpt       String     @default("") @db.Text // subtitle shown under the title and on cards
  // TipTap/ProseMirror JSON. Never HTML: the public page renders it node by node into React elements.
  content       Json
  contentText   String     @default("") @db.Text // plain text copy, used for search and reading time
  category      String     @default("") // slug from BLOG_CATEGORIES in lib/blog-constants.js
  tags          String[]
  level         PostLevel?
  keyTakeaways  String[]
  resources     Json? // [{ type: 'github' | 'notebook' | 'dataset' | 'docs' | 'other', label, url }]
  // Problem ids the admin picked as practice questions, shown under the article in this order
  practiceProblemIds String[]
  coverImage    String?
  coverAlt      String?
  seoTitle      String?
  metaDescription String?
  canonicalUrl  String?
  featured      Boolean    @default(false)
  status        PostStatus @default(DRAFT)
  publishedAt   DateTime?
  scheduledFor  DateTime?
  readingMinutes Int       @default(1)
  views         Int        @default(0)
  // Set only when an admin saves. updatedAt also moves when views are counted, so it cannot be used for
  // dateModified in structured data or sitemap lastmod.
  lastEditedAt  DateTime   @default(now())
  authorId      String
  author        User       @relation(fields: [authorId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  likes     BlogLike[]
  comments  BlogComment[]
  feedback  BlogFeedback[]
  revisions BlogRevision[]
  
  @@index([kind, status, publishedAt]) 
  @@index([kind, category, folder])
  @@index([status, publishedAt])
  @@index([category, status, publishedAt])
  @@index([featured, status])
  @@index([tags], type: Gin)
}

model BlogRevision {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  title     String
  content   Json
  note      String?
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model BlogLike {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

// "Was this article helpful?" One answer per user, which they can change.
model BlogFeedback {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, userId])
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}