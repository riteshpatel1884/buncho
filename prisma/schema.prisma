generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum PollType {
  OPINION
  PREDICTION
  CROWD_QUESTION
}

enum PollStatus {
  OPEN
  RESOLVED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  username  String   @unique
  name      String
  imageUrl  String?
  bio       String?
  role      Role     @default(USER)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  polls Poll[]
  votes PollVote[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  polls Poll[]
}

model Poll {
  id                 String     @id @default(cuid())
  question           String
  description        String?
  type               PollType
  status             PollStatus @default(OPEN)
  resolutionCriteria String?
  resolutionSource   String?
  closesAt           DateTime
  createdAt          DateTime   @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  options    PollOption[]
  votes      PollVote[]
  tags       Tag[]
  resolution PollResolution?

  @@index([status, closesAt])
  @@index([createdAt])
  @@index([authorId])
}

model PollOption {
  id       String @id @default(cuid())
  text     String
  position Int
  pollId   String
  poll     Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId]) // one vote per user per poll, enforced by the DB
  @@index([optionId])
}

model PollResolution {
  id              String   @id @default(cuid())
  pollId          String   @unique
  winningOptionId String
  evidenceNote    String
  evidenceUrl     String?
  resolvedById    String
  resolvedAt      DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
}