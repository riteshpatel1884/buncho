generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  EXPERT
}

enum ExpertStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ServiceType {
  RESUME_REVIEW
  MOCK_INTERVIEW
  CAREER_GUIDANCE
  PROJECT_REVIEW
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  DECLINED
}

enum PaymentStatus {
  FREE          // price is 0, nothing to pay
  UNPAID        // waiting for the student to pay on Dodo
  PAID
  REFUNDED
  REFUND_FAILED // needs a manual refund from the Dodo dashboard
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  avatarUrl   String?
  role        Role?
  createdAt   DateTime @default(now())

  studentProfile StudentProfile?
  expertProfile  ExpertProfile?
  bookings       Booking[]       @relation("StudentBookings")
}

model StudentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  college    String
  branch     String
  year       String
  skills     String[]
  targetRole String
  careerGoal String
  problems   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExpertProfile {
  id                 String       @id @default(cuid())
  userId             String       @unique
  slug               String       @unique
  headline           String?
  college            String
  branch             String
  graduationYear     Int
  company            String
  jobTitle           String
  experienceYears    Int
  skills             String[]
  bio                String
  linkedinUrl        String
  githubUrl          String?
  status             ExpertStatus @default(PENDING)
  educationVerified  Boolean      @default(false)
  employmentVerified Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Blue tick (paid)
  blueTickUntil      DateTime?
  dodoSubscriptionId String?   @unique
  dodoCustomerId     String?
  dodoStatus         String?   // ACTIVE | ON_HOLD | CANCELLING | CANCELLED | EXPIRED | ONE_TIME

  // Set when a verified expert changes details, so an admin re-checks them
  needsReview      Boolean  @default(false)
  unverifiedFields String[] @default([])

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     Service[]
  availability Availability[]
  bookings     Booking[]

  @@index([status, createdAt])
}

model Service {
  id           String      @id @default(cuid())
  expertId     String
  type         ServiceType
  title        String
  description  String
  priceInr     Int
  durationMin  Int
  deliverables String[]
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())

  expert   ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([expertId, active])
}

// Weekly recurring window, in India time. weekday: 0 = Sunday ... 6 = Saturday.
// Not used by booking any more. Kept until you decide to remove it.
model Availability {
  id       String @id @default(cuid())
  expertId String
  weekday  Int
  startMin Int
  endMin   Int

  expert ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([expertId])
}

model Booking {
  id            String        @id @default(cuid())
  studentId     String
  expertId      String
  serviceId     String
  status        BookingStatus @default(PENDING)
  note          String?       // the student's question
  meetingUrl    String?       // no longer used, meeting links are not allowed
  priceInr      Int
  paymentStatus PaymentStatus @default(FREE) // FREE default keeps old bookings valid
  dodoPaymentId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  cancelledBy     String?   // "EXPERT" or "STUDENT"
  statusChangedAt DateTime?
  resolvedAt      DateTime? // set when the admin has dealt with a refund case

  student User          @relation("StudentBookings", fields: [studentId], references: [id])
  expert  ExpertProfile @relation(fields: [expertId], references: [id])
  service Service       @relation(fields: [serviceId], references: [id])
  replies BookingReply[]

  @@index([expertId, createdAt])
  @@index([studentId, createdAt])
  @@index([paymentStatus, createdAt])
}

model BlueTickPayment {
  paymentId String   @id
  expertId  String
  createdAt DateTime @default(now())
}

model BookingReply {
  id         String    @id @default(cuid())
  bookingId  String
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  body       String
  flags      String[]  @default([])
  status     String    @default("PENDING") // PENDING | SENDING | SENT | SEND_FAILED | REJECTED
  adminNote  String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  sentAt     DateTime?

  @@index([status, createdAt])
  @@index([bookingId])
}