generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/* ---------- Enums ---------- */

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemType {
  CONCEPTUAL
  PRACTICAL
  DEBUGGING
  SYSTEM_DESIGN
  CASE_STUDY
}

enum ProgressStatus {
  ATTEMPTED
  COMPLETED
}

// Phase 3
enum AnswerStatus {
  PUBLISHED
  UNSHARED
  HIDDEN
}

enum ReportReason {
  INCORRECT
  COPIED
  INAPPROPRIATE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

/* ---------- Core models (Phase 1-2) ---------- */

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions      Submission[]
  bookmarks        Bookmark[]
  progress         ProblemProgress[]
  // Phase 3
  communityAnswers CommunityAnswer[]
  answerVotes      AnswerVote[]
  answerBookmarks  AnswerBookmark[]
  reports          Report[]
  comments         AnswerComment[]
  // Phase 4
  evaluations      Evaluation[]

  @@index([email])
}

model Topic {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  order       Int       @default(0)
  problems    Problem[]
}

model Problem {
  id                String      @id @default(cuid())
  slug              String      @unique
  title             String
  description       String      @db.Text // Markdown
  topicId           String
  topic             Topic       @relation(fields: [topicId], references: [id])
  subcategory       String?
  difficulty        Difficulty
  type              ProblemType
  roles             String[]
  estimatedMinutes  Int         @default(10)
  hints             String[]
  // If true, users may reveal the solution without submitting an attempt
  allowDirectReveal Boolean     @default(false)
  published         Boolean     @default(true)
  position          Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Phase 5: production challenges
  isChallenge  Boolean @default(false)
  scenarioData Json? // [{ title, kind, content }] logs, configs, sample data
  steps        Json? // [{ title, prompt }] step-by-step answer
  rubric       Json? // [{ id, criterion, weight }] used by the AI, shown after feedback

  expertSolution   ExpertSolution?
  related          Problem[]         @relation("RelatedProblems")
  relatedBy        Problem[]         @relation("RelatedProblems")
  submissions      Submission[]
  bookmarks        Bookmark[]
  progress         ProblemProgress[]
  // Phase 3
  communityAnswers CommunityAnswer[]
  // Phase 4
  evaluations      Evaluation[]

  @@index([topicId, difficulty])
  @@index([published, difficulty])
  @@index([isChallenge, published])
}

// Authoritative, admin-curated. Kept separate from user content on purpose.
model ExpertSolution {
  id           String    @id @default(cuid())
  problemId    String    @unique
  problem      Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  content      String    @db.Text // Markdown
  // Phase 5: alternative approaches and trade-offs (Markdown)
  alternatives String?   @db.Text
  // Only set these after a real human review
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Private to the user. Public sharing creates a separate CommunityAnswer copy.
model Submission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 4
  evaluations Evaluation[]

  @@unique([userId, problemId])
  @@index([problemId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, problemId])
  @@index([userId])
}

model ProblemProgress {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId        String
  problem          Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status           ProgressStatus @default(ATTEMPTED)
  solutionRevealed Boolean        @default(false)
  completedAt      DateTime?
  lastActivityAt   DateTime       @default(now())
  createdAt        DateTime       @default(now())

  @@unique([userId, problemId])
  @@index([userId, status])
}

/* ---------- Community (Phase 3) ---------- */

// Public copy of a user's answer, created only when they choose to share.
// Editing the private Submission never changes this until the user updates the shared version.
model CommunityAnswer {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  content   String       @db.Text // Markdown
  anonymous Boolean      @default(false)
  status    AnswerStatus @default(PUBLISHED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  votes     AnswerVote[]
  bookmarks AnswerBookmark[]
  reports   Report[]
  comments  AnswerComment[]

  // One shared answer per user per problem
  @@unique([userId, problemId])
  @@index([problemId, status])
}

// "Helpful" votes. The unique constraint prevents duplicate votes.
model AnswerVote {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerId  String
  answer    CommunityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, answerId])
  @@index([answerId])
}

model AnswerBookmark {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerId  String
  answer    CommunityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, answerId])
  @@index([userId])
}

// One report per user per answer. Open reports from distinct users drive auto-hide.
model Report {
  id         String          @id @default(cuid())
  reporterId String
  reporter   User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  answerId   String
  answer     CommunityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?         @db.Text
  status     ReportStatus    @default(OPEN)
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  @@unique([reporterId, answerId])
  @@index([status, createdAt])
  @@index([answerId])
}

model AnswerComment {
  id        String          @id @default(cuid())
  answerId  String
  answer    CommunityAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String          @db.Text
  createdAt DateTime        @default(now())

  @@index([answerId, createdAt])
  @@index([userId, createdAt])
}

/* ---------- AI feedback (Phase 4) ---------- */

// One row per evaluation run; the newest row for a submission is shown.
model Evaluation {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId    String
  problem      Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contentHash  String // sha256 of the answer that was evaluated
  score        Int // 0-100, summed from the rubric
  scores       Json // { coverage, accuracy, reasoning, clarity }
  feedback     Json // { summary, strengths, missing, inaccuracies, rubricResults, ... }
  provider     String
  model        String
  latencyMs    Int
  fallbacks    Int        @default(0) // providers that failed before this one answered
  createdAt    DateTime   @default(now())

  @@index([submissionId, createdAt])
  @@index([userId, createdAt])
}